# Image « rapide » pour les publications : réutilise les programmes déjà compilés (linux musl, statiques)
# au lieu de recompiler sous émulation. Le Dockerfile normal reste celui à utiliser pour construire soi-même.
FROM alpine:3.20
RUN apk add --no-cache tini ca-certificates
ARG TARGETARCH
COPY bin/${TARGETARCH}/kesal-rangeur /usr/local/bin/kesal-rangeur
ENV KESAL_CONFIG=/config/config.toml \
    KESAL_BIND=0.0.0.0:3050
WORKDIR /config
VOLUME /config
EXPOSE 3050
LABEL org.opencontainers.image.source="https://github.com/keketrial/kesal-rangeur" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.description="Range automatiquement films et séries (TMDB, Plex/Jellyfin)"
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -qO- http://127.0.0.1:3050/healthz >/dev/null || exit 1
ENTRYPOINT ["/sbin/tini", "--", "kesal-rangeur"]
CMD ["serve"]
